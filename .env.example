# Aria V2 - environment template. Copy to .env.local and fill in. NEVER commit .env.local.

# -- App --
NODE_ENV=development
APP_BASE_URL=                     # public URL, e.g. https://aria-v2.vercel.app (OAuth + Pub/Sub + magic links)

# -- Supabase (aria-v2 project) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never ship to the client

# -- LLM --
ANTHROPIC_API_KEY=                # primary (Haiku 5.5 / Sonnet 5.5)
OPENAI_API_KEY=                   # fallback model (GPT-6 Luna)

# -- iMessage (Sendblue) --
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_SIGNING_SECRET=          # inbound webhook signature (confirm exact name in Sendblue docs)

# -- Redis (Upstash, serverless) --
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Google OAuth (Gmail + Calendar) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=              # <APP_BASE_URL>/api/google/callback
GMAIL_PUBSUB_TOPIC=               # projects/<project-id>/topics/<topic> (Gmail push)

# -- Crypto & server secrets (generate each: openssl rand -base64 32) --
APP_ENCRYPTION_KEY=               # 32-byte base64, AES-256-GCM for OAuth-token encryption at rest
SESSION_SECRET=                   # web-session + magic-link signing
JOBS_DISPATCH_SECRET=             # HMAC: Supabase Cron -> /api/jobs/dispatch

# -- Python parser service --
PARSER_SERVICE_URL=               # e.g. http://localhost:8000
PARSER_SHARED_SECRET=             # shared secret between TS app and parser

# -- Monitoring --
SENTRY_DSN=
