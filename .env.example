# Aria V2 - environment template. Copy to .env.local and fill in. NEVER commit .env.local.
# Names only; never put real values in this file. Reference: docs/plans/2026-10-10-v2-master-plan.md §4.

# -- App --
NODE_ENV=development
APP_BASE_URL=                     # public URL, e.g. https://aria-v2.vercel.app (OAuth + Pub/Sub + magic links); required in prod

# -- Supabase (aria-v2 project) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never ship to the client

# -- LLM --
ANTHROPIC_API_KEY=                # primary (Haiku 5.5 / Sonnet 5.5)
OPENAI_API_KEY=                   # optional fallback (GPT-6 Luna); deferred
AGENT_ESCALATION_CAP_PCT=10       # optional; max % of LLM turns escalated to Sonnet (trailing 7 days)
ARIA_AGENT=stub                   # optional; `stub` until the real agent lands

# -- iMessage (Sendblue) -- required in prod
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_SIGNING_SECRET=          # inbound webhook signature; comma-separated list allows rotation
SENDBLUE_FROM_NUMBER=             # Aria's number (E.164) — landing-page sms: links
SENDBLUE_API_BASE=                # optional override of the Sendblue API base URL (.com vs .co unverified)

# -- Channel --
CHANNEL_PROVIDER=dev              # dev | sendblue
DEV_CHANNEL_SECRET=               # dev channel provider auth (local only)

# -- Redis (Upstash, serverless) -- required in prod; dev falls back to the DB lease + in-memory rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Google OAuth (Gmail + Calendar) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=              # optional; defaults to <APP_BASE_URL>/api/google/callback
GMAIL_PUBSUB_TOPIC=               # projects/<project-id>/topics/<topic> (Gmail push); unset in dev = polling
GMAIL_PUSH_SERVICE_ACCOUNT=       # service-account email Pub/Sub signs push OIDC tokens with
GMAIL_PUSH_AUDIENCE=              # optional; expected OIDC audience of push requests
GMAIL_PUSH_SUBSCRIPTION=          # optional; expected Pub/Sub subscription name
GOOGLE_PKCE=                      # optional; enable PKCE on the OAuth flow

# -- Crypto & server secrets (generate each: openssl rand -base64 32) --
APP_ENCRYPTION_KEY=               # 32-byte base64, AES-256-GCM for OAuth-token / iCal-URL encryption at rest
SESSION_SECRET=                   # web-session + magic-link signing
JOBS_DISPATCH_SECRET=             # HMAC: Supabase Cron -> /api/jobs/dispatch; must equal Vault `aria_dispatch_secret`
CRON_SECRET=                      # Vercel Cron bearer (openssl rand -hex 32); required in prod

# -- Python parser service (TS side) --
PARSER_SERVICE_URL=               # e.g. http://localhost:8000 (Cloud Run URL in prod)
PARSER_SHARED_SECRET=             # shared HMAC secret between TS app and parser
PARSER_TIMEOUT_MS=280000          # optional
SYLLABUS_MEDIA_ALLOWED_HOSTS=     # optional; comma list of hosts syllabus media may be fetched from (Sendblue CDN)
SYLLABUS_MAX_PDF_BYTES=           # optional
SYLLABUS_UPLOAD_MAX_BYTES=        # optional
SYLLABUS_DAILY_LIMIT=             # optional; per-user syllabus parses per day

# -- Canvas --
CANVAS_FEED_MAX_BYTES=            # optional; max iCal feed size
CANVAS_SYNC_DISABLED=             # optional; set to disable Canvas sync
CANVAS_LIVE_TEST_URL=             # tests only; a real feed URL — never commit a value

# -- Monitoring --
SENTRY_DSN=                       # optional

# -- Tests --
EVAL_MODE=                        # optional; evals harness mode
EVAL_DEV_CHANNEL_URL=             # optional; dev channel endpoint for evals
EVAL_REPEAT=                      # optional; repeats per eval case
E2E_BASE_URL=                     # optional; Playwright base URL
