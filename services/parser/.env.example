# Aria parser service env (V2-08 §6). Copy to services/parser/.env.local for docker compose.
# Cloud Run: secrets come from Secret Manager (V2-08 §12), the rest from --set-env-vars.

# Separate Anthropic key (workspace "aria-parser"). Required unless PARSER_FAKE_LLM=1.
ANTHROPIC_API_KEY=
# HMAC key shared with the TS app (>= 32 chars; `openssl rand -base64 48`). Required.
PARSER_SHARED_SECRET=
# Previous secret, accepted during rotation only.
PARSER_SHARED_SECRET_PREVIOUS=

PARSER_PRIMARY_MODEL=claude-sonnet-5-5
# Empty disables escalation.
PARSER_ESCALATION_MODEL=claude-opus-5-5
PARSER_PRIMARY_EFFORT=medium
PARSER_ESCALATION_EFFORT=high
# Server-side refusal fallbacks (beta server-side-fallback-2026-07-01, fallbacks:"default").
# Off by default: our own Opus escalation handles refusals, and a server-side fallback model
# would be priced by the TS table under a model id it may not know.
PARSER_SERVER_FALLBACKS=0

PARSER_MAX_PDF_BYTES=15728640
PARSER_SLICE_ABOVE_PAGES=40
PARSER_SLICE_TO_PAGES=20
PARSER_HARD_MAX_PAGES=300
# Total budget per request (seconds); escalation is skipped once attempt 1 ends after 150 s.
PARSER_DEADLINE_S=250
# HMAC timestamp window (seconds).
PARSER_CLOCK_SKEW_S=300

PORT=8080
LOG_LEVEL=info

# Dev only: serve a canned extraction without calling Anthropic. Refused when K_SERVICE
# (Cloud Run) or VERCEL is set.
PARSER_FAKE_LLM=
# Tests only: 1 enables tests/test_live.py (pytest -m live).
ARIA_LIVE_LLM=
