{
  "expo": {
    "name": "Aria",
    "slug": "aria-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aria",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cr7sc3.aria",
      "buildNumber": "1",
      "appleTeamId": "B4V6MXCJ5B",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aria uses your microphone to accept voice commands.",
        "NSSpeechRecognitionUsageDescription": "Aria transcribes your voice to send messages to your assistant.",
        "NSPhotoLibraryUsageDescription": "Aria accesses your files to upload course syllabi.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "router": {
      "root": "app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a515bf7-8cd7-4953-8177-aa9afec42b60"
      }
    }
  }
}
